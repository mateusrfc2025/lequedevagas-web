generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Vaga {
  id               String   @id @default(uuid())
  titulo           String
  empresa          String
  empresaSlug      String
  area             String
  senioridade      String
  local            String
  descricao        String
  aceitaIniciante  Boolean  @default(false)
  createdAt        DateTime @default(now())
  candidaturas     Candidatura[]
}

model Empresa {
  slug String @id
  nome String
  sobre String
  site String
}

model Pessoa {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senha        String
  papel        String
  candidaturas Candidatura[]
}

model Candidatura {
  id        String   @id @default(uuid())
  nome      String   // Mantemos no banco para legados/anônimos, se houver
  email     String
  vagaId    String
  vaga      Vaga     @relation(fields: [vagaId], references: [id])
  pessoaId  String?  // <-- NOVO: Opcional conforme o briefing (Parte 3.1)
  pessoa    Pessoa?  @relation(fields: [pessoaId], references: [id]) // <-- NOVO
  criadaEm  DateTime @default(now())
}