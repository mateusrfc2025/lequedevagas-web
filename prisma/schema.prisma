generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Vaga {
  id               String   @id @default(uuid())
  titulo           String
  empresa          String
  empresaSlug      String
  area             String
  senioridade      String
  local            String
  descricao        String
  aceitaIniciante  Boolean  @default(false)
  createdAt        DateTime @default(now())
}