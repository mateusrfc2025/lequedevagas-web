generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Vaga {
  id               String   @id @default(uuid())
  titulo           String
  empresa          String
  empresaSlug      String
  area             String
  senioridade      String
  local            String
  descricao        String
  aceitaIniciante  Boolean  @default(false)
  createdAt        DateTime @default(now())
  candidaturas     Candidatura[]

  // Frente 1 (aula 7): quem publicou. Opcional: as vagas antigas não têm dono.
  autorId          String?
  autor            Pessoa?  @relation(fields: [autorId], references: [id])
}

model Empresa {
  slug String @id
  nome String
  sobre String
  site String
}

model Candidatura {
  id        String   @id @default(uuid())
  nome      String
  email     String
  vagaId    String
  vaga      Vaga     @relation(fields: [vagaId], references: [id]) // Relação com a Vaga
  criadaEm  DateTime @default(now())
}

// "candidata" ou "empresa". String e não enum: Prisma 5 não tem enum no SQLite.
model Pessoa {
  id          String  @id @default(uuid())
  nome        String
  email       String  @unique
  senhaHash   String
  papel       String  @default("candidata")
  empresaSlug String?

  vagas       Vaga[]
}
